{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "paths": {
      "@edugrid/pv-sim": ["./../packages/pv-sim/src/index.js"],
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "../packages/pv-sim/src/**/*.js"
  ],
  "exclude": ["dist", "node_modules"]
}
